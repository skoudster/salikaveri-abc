      },
      {
        "id": "glute-figure-four",
        "name": "Pakaravenytys selinmakuulla",
        "dose": "30 s / puoli",
        "instructions": "Nilkka vastakkaisen polven päälle ja reisi kevyesti kohti vartaloa."
